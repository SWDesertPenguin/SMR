{
  "name": "smr",
  "version": "2.2.0",
  "description": "SMR (Standalone Markdown Reader): a simple desktop Markdown reader and editor with tabs",
  "homepage": "https://github.com/SWDesertPenguin/SMR",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor.mjs",
    "lint": "eslint .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "SWDesertPenguin",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.smr.app",
    "productName": "SMR",
    "copyright": "Copyright © 2026 SWDesertPenguin",
    "publish": [
      {
        "provider": "github",
        "owner": "SWDesertPenguin",
        "repo": "SMR"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "icon-dark.png",
      "icon-dark.ico",
      "src/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "icon-dark.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon-dark.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "SMR ${version}"
    },
    "linux": {
      "icon": "icon-dark.png",
      "maintainer": "SWDesertPenguin <SWDesertPenguin@users.noreply.github.com>",
      "category": "Office;TextEditor",
      "synopsis": "Standalone Markdown reader and editor with tabs",
      "mimeTypes": [
        "text/markdown"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
